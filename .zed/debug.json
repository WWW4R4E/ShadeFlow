// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "cwd": "$ZED_WORKTREE_ROOT/ShadeFlowNative",
    "label": "run",
    "sourceLanguages": ["zig"],
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/ShadeFlowNative/zig-out/bin/ShadeFlowNative.exe",
    "build": {
      "label": "zig build",
      "command": "zig",
      "args": ["build"],
      "cwd": "$ZED_WORKTREE_ROOT/ShadeFlowNative",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
    },
  },
]
